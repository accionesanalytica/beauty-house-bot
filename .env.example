# Copiá este archivo como .env para desarrollo local y completá valores propios.
# Nunca subas .env ni pegues secretos en documentación, chats o commits.

# --- IA ---
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key

# --- WhatsApp / Meta ---
WHATSAPP_TOKEN=your_meta_system_user_token
PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_verify_token
# Número de Isa/equipo en formato internacional, sin + ni espacios.
ISA_WHATSAPP_NUMBER=your_isa_whatsapp_number

# --- Base de datos ---
SUPABASE_DB_URL=postgresql://postgres:your_password@your-host:5432/postgres

# --- Tiendanube ---
TIENDANUBE_STORE_ID=your_tiendanube_store_id
TIENDANUBE_STORE_DOMAIN=your-store.mitiendanube.com
TIENDANUBE_USER_AGENT=FredBot (support@example.com)
# Fallback de desarrollo. En producción se prefiere la autorización OAuth
# cifrada que Fred guarda en Supabase.
TIENDANUBE_ACCESS_TOKEN=your_tiendanube_access_token
TIENDANUBE_CLIENT_ID=your_tiendanube_client_id
TIENDANUBE_CLIENT_SECRET=your_tiendanube_client_secret
TIENDANUBE_OAUTH_CREDENTIALS_ENABLED=true

# Credenciales aisladas para el recorrido demo. Nunca reutilizarlas en Railway.
TIENDANUBE_DEMO_STORE_ID=your_demo_store_id
TIENDANUBE_DEMO_ACCESS_TOKEN=your_demo_tiendanube_access_token
TIENDANUBE_DRAFT_ORDERS_MODE=disabled
DEMO_APPROVALS_ENABLED=false

# Solo usar production después de una prueba controlada de checkout real.
TIENDANUBE_CHECKOUT_MODE=disabled
# El webhook de pagos se configura desde /admin después de validar checkout.
TIENDANUBE_WEBHOOKS_ENABLED=false

# --- Comportamiento seguro de Fred ---
# template = respuesta inicial de Meta; agent = conversación completa de Fred.
BOT_RESPONSE_MODE=template
SALES_INTAKE_ENABLED=false
KNOWLEDGE_RAG_ENABLED=false
# local = Markdown incluido en el repo; supabase = pgvector con fallback a local.
KNOWLEDGE_RAG_SOURCE=local
# open, allowlist o paused. allowlist usa teléfonos separados por comas.
FRED_CUSTOMER_MODE=open
FRED_BETA_ALLOWED_PHONES=
ISA_REMINDERS_ENABLED=false

# --- Fred v2 shadow read-only ---
# Mantener false hasta aplicar 011_fred_v2_shadow_observations.sql y aprobar
# una activación controlada. V1 sigue siendo el único agente que responde.
FRED_V2_SHADOW_ENABLED=false
# Deadline propio del observer; no cambia los timeouts ni la latencia de v1.
FRED_V2_SHADOW_TIMEOUT_SECONDS=12

# --- Panel interno ---
ADMIN_DASHBOARD_USERNAME=choose_an_internal_username
ADMIN_DASHBOARD_PASSWORD=choose_a_long_unique_password

# --- Mensajes iniciados por Fred (solo con plantilla Meta aprobada) ---
PAYMENT_CONFIRMED_TEMPLATE_NAME=
PAYMENT_CONFIRMED_TEMPLATE_LANGUAGE=es_AR
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_TEMPLATE_NAME=
DAILY_SUMMARY_TEMPLATE_LANGUAGE=es_AR

# --- Cola durable de mensajes (M1) ---
# Mantener en false hasta terminar la validación controlada de la migración
# 008 contra Postgres real. Con false, el webhook usa la ruta síncrona actual
# y ninguna de las variables de abajo tiene efecto.
DURABLE_MESSAGE_PROCESSING_ENABLED=false
# Segundos de silencio tras el último mensaje antes de procesar la ráfaga.
MESSAGE_QUIET_WINDOW_SECONDS=1.5
# Tope máximo de espera desde el primer mensaje de la ráfaga, aunque la
# clienta siga escribiendo sin pausa.
MESSAGE_MAX_BURST_WAIT_SECONDS=5
# Duración del lease que un worker mantiene sobre una conversación mientras
# la procesa; otro worker puede reclamarla si expira sin renovarse.
MESSAGE_LEASE_SECONDS=120
# Intervalo de sondeo de cada worker cuando no hay conversaciones listas.
MESSAGE_WORKER_POLL_SECONDS=0.25

# --- Despliegue ---
# Railway inyecta PORT automáticamente; normalmente no hace falta definirlo.
PORT=8000
PUBLIC_BASE_URL=https://your-fred-domain.example.com
