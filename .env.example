# Copiá este archivo como .env para desarrollo local y completá los valores.
# Nunca subas .env ni pegues secretos en documentación o chats.

DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key

WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# Número de Isa en formato internacional, sin + ni espacios.
# Es el destinatario de los avisos y botones de aprobación.
ISA_WHATSAPP_NUMBER=your_isa_whatsapp_number

TIENDANUBE_STORE_ID=your_tiendanube_store_id
TIENDANUBE_ACCESS_TOKEN=your_tiendanube_access_token
TIENDANUBE_USER_AGENT=BeautyHouseBot (support@example.com)

# Isolated demo-only credentials. Never reuse these values in Railway.
TIENDANUBE_DEMO_STORE_ID=8068892
TIENDANUBE_DEMO_ACCESS_TOKEN=your_demo_tiendanube_access_token
# Only "demo" permits the Isa command: demo: SKU x cantidad
TIENDANUBE_DRAFT_ORDERS_MODE=disabled

SUPABASE_DB_URL=postgresql://postgres:your_password@your-host:5432/postgres

# "template" mantiene la respuesta actual de Meta. No cambiar a "agent"
# hasta terminar las pruebas de conversación e historial.
BOT_RESPONSE_MODE=template
